# Copy to .env locally. Never commit the real file or share docker inspect output.
HA_URL=https://homeassistant.example.internal:8123
HA_TOKEN=
ALLOW_PLAINTEXT_HA=false
ROOMS=office,living_room
CAPTURE_SECONDS=300
MAX_MESSAGES=10000
PUID=99
PGID=100
APPDATA=./appdata
# Replace example entity IDs with your actual HA IDs before first capture.
OFFICE_PRIMARY_LIGHT=light.office_ceiling
OFFICE_EXTRA_LIGHT=light.office_accent
OFFICE_PIR=binary_sensor.office_motion_occupancy
OFFICE_MMWAVE=binary_sensor.office_presence_occupancy
OFFICE_DERIVED=binary_sensor.office_occupancy
OFFICE_LUX=sensor.office_ambient_illuminance_lux
LIVING_ROOM_PRIMARY_LIGHT=light.living_room_ceiling
LIVING_ROOM_EXTRA_LIGHT=light.living_room_lamp
LIVING_ROOM_PIR=binary_sensor.living_room_motion_occupancy
LIVING_ROOM_MMWAVE=binary_sensor.living_room_presence_occupancy
LIVING_ROOM_DERIVED=binary_sensor.living_room_occupancy
LIVING_ROOM_LUX=sensor.living_room_ambient_illuminance_lux
LIVING_ROOM_MEDIA=media_player.living_room_tv
